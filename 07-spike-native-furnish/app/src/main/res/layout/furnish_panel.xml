<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#E615130F"
  android:orientation="vertical"
  android:padding="16dp"
>
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Maison3D: hold A and talk · grip to move this"
    android:textColor="#ECE6DA"
    android:textSize="22sp"
    android:textStyle="bold"
  />
  <TextView
    android:id="@+id/said"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text=""
    android:textColor="#E4B363"
    android:textSize="18sp"
  />
  <TextView
    android:id="@+id/reply"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text=""
    android:textColor="#ECE6DA"
    android:textSize="18sp"
  />
  <TextView
    android:id="@+id/status"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="8dp"
    android:fontFamily="monospace"
    android:text="Loading the room…"
    android:textColor="#B9B1A3"
    android:textSize="12sp"
  />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
  >
    <Button
      android:id="@+id/rescan"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_margin="4dp"
      android:layout_weight="1"
      android:backgroundTint="#E4B363"
      android:text="Rescan room"
      android:textColor="#15130F"
    />
    <Button
      android:id="@+id/view"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_margin="4dp"
      android:layout_weight="1"
      android:backgroundTint="#9FC5D9"
      android:text="Real room"
      android:textColor="#15130F"
    />
    <Button
      android:id="@+id/reload"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_margin="4dp"
      android:layout_weight="1"
      android:text="Reload room (B)"
    />
    <Button
      android:id="@+id/clear"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_margin="4dp"
      android:layout_weight="1"
      android:text="Clear furniture"
    />
  </LinearLayout>
</LinearLayout>
